# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — it never gets committed or pushed to GitHub.

# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — Project Settings -> Database -> Connection string (URI, with password filled in)
# Only used locally to run scripts/run-migration.mjs, never at app runtime.
SUPABASE_DB_URL=

# Any secret word — required to reach the /signup page.
INVITE_CODE=

# Phase 3 — Web Push (VAPID). Generate once with: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Phase 3 — secures the /api/cron/reminders dispatcher (external cron-job.org
# pinger hits it with this as a Bearer token) and the security-definer RPCs
# it calls (see supabase/migrations/0012_reminder_dispatcher_rpcs.sql).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Must also be inserted into the app_secrets table (key='cron_secret') —
# see that same migration's comments for why (SUPABASE_SERVICE_ROLE_KEY was
# never filled in, so this app doesn't use it).
CRON_SECRET=

# Phase 3 — signs push notification-action tokens (Done/Snooze). Generate
# the same way as CRON_SECRET above, as a separate value.
PUSH_ACTION_SECRET=

# Phase 3 — encrypts gcal_connections.refresh_token_encrypted (AES-256-GCM
# key, must decode to exactly 32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GCAL_TOKEN_ENCRYPTION_KEY=

# Phase 3 — Google Calendar OAuth. From Google Cloud Console — see
# MANUAL.md's Phase 3 section for click-by-click setup steps. Needs
# Authorized redirect URIs for both localhost:3000 and the production
# domain, each ending in /api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
