# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — it never gets committed or pushed to GitHub.

# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — Project Settings -> Database -> Connection string (URI, with password filled in)
# Only used locally to run scripts/run-migration.mjs, never at app runtime.
SUPABASE_DB_URL=

# Any secret word — required to reach the /signup page.
INVITE_CODE=
